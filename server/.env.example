# Safe example configuration only.
# Never commit real host addresses, Tailscale IPs, tokens, or credentials.

# Safe default: reachable only from the server itself.
# For Tailscale access, copy this file to .env locally and set this value to
# the server's own Tailscale IP without committing the resulting .env file.
PROJECT_STATUS_BIND_ADDRESS=127.0.0.1
PROJECT_STATUS_PORT=8080
